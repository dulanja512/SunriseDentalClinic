<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Audit Logs - Sunrise Dental</title></head><body>
<jsp:include page="includes/header.jsp"/><main class="container"><div class="page-head"><div><h1>System Audit Logs</h1><div class="muted">Administrator view of important activity in the clinic system.</div></div></div><section class="panel"><c:choose><c:when test="${empty logs}"><div class="empty">No audit events recorded yet.</div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>User ID</th><th>Action</th><th>Details</th><th>IP Address</th><th>Time</th></tr></thead><tbody><c:forEach var="l" items="${logs}"><tr><td>${l.userId}</td><td><strong><c:out value="${l.action}"/></strong></td><td><c:out value="${l.details}"/></td><td><c:out value="${l.ipAddress}"/></td><td>${l.createdAt}</td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></main></body></html>
