<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Appointment Details - Sunrise Dental</title></head><body>
<jsp:include page="includes/header.jsp"/>
<main class="container"><div class="page-head"><div><h1>Appointment Details</h1><div class="muted">Review patient, dentist and treatment information.</div></div><a class="btn btn-light" href="${pageContext.request.contextPath}/appointments">Back to Appointments</a></div>
<jsp:include page="includes/flash.jsp"/>
<c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if>
<c:if test="${not empty appointment}"><section class="panel"><div class="section-title"><h2><c:out value="${appointment.appointmentNumber}"/></h2><span class="badge ${appointment.status eq 'BOOKED' ? 'badge-blue' : (appointment.status eq 'COMPLETED' ? 'badge-green' : 'badge-red')}">${appointment.status}</span></div><div class="grid grid-3"><div><div class="muted">Patient</div><strong><c:out value="${appointment.patient.fullName}"/></strong><p><c:out value="${appointment.patient.address}"/><br><c:out value="${appointment.patient.contactNumber}"/><br><c:out value="${appointment.patient.email}"/></p></div><div><div class="muted">Clinical details</div><p><strong><c:out value="${appointment.dentist.fullName}"/></strong><br><c:out value="${appointment.dentist.specialization}"/></p><p><strong><c:out value="${appointment.treatment.treatmentName}"/></strong></p></div><div><div class="muted">Schedule</div><p><strong>${appointment.appointmentDate}</strong><br>${appointment.appointmentTime}</p></div></div><hr style="border:0;border-top:1px solid #e2e8f0;margin:20px 0"><form method="post" action="${pageContext.request.contextPath}/billing"><input type="hidden" name="appointmentId" value="${appointment.appointmentId}"><button type="submit">Generate / View Bill</button></form></section></c:if></main></body></html>
